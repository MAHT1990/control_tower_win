<Window x:Class="ControlTowerWin.Features.Settings.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="터미널 글꼴 (전체 터미널 공통)" FontWeight="Bold" Margin="0,0,0,8"/>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="글꼴 종류" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding MonospaceFamilies}"
                      SelectedItem="{Binding FontFamily}" IsEditable="False"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="글꼴 크기" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="pt (6~72)" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="Gray"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" Foreground="#D32F2F" Margin="90,0,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True" Width="72" Margin="0,0,8,0" Padding="0,4"/>
            <Button Content="저장" Command="{Binding SaveCommand}" Width="72" Padding="0,4"/>
        </StackPanel>
    </Grid>
</Window>
